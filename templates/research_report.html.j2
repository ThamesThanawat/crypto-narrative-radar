    function setReportLanguage(language) {
      const selectedLanguage = language === "th" ? "th" : "en";
      document.documentElement.lang = selectedLanguage === "th" ? "th" : "en";
      document.body.dataset.language = selectedLanguage;
      document.title = selectedLanguage === "th"
        ? "Crypto Narrative Radar - รายงานตัวอย่าง"
        : "Crypto Narrative Radar - {{ snapshot_date }}";

      document.querySelectorAll("[data-i18n]").forEach((element) => {
        if (!element.dataset.enHtml) {
          element.dataset.enHtml = element.innerHTML;
        }
        const key = element.dataset.i18n;
        element.innerHTML = selectedLanguage === "th" && thaiTranslations[key]
          ? thaiTranslations[key]
          : element.dataset.enHtml;
      });

      document.querySelectorAll("[data-th-text]").forEach((element) => {
        element.textContent = selectedLanguage === "th"
          ? element.dataset.thText
          : element.dataset.enText;
      });

      document.querySelectorAll("th").forEach((heading) => {
        if (!heading.dataset.enText) {
          heading.dataset.enText = heading.textContent.trim();
        }
        heading.textContent = selectedLanguage === "th"
          ? thaiColumnLabels[heading.dataset.enText] || heading.dataset.enText
          : heading.dataset.enText;
      });

      document.querySelectorAll("[data-language-button]").forEach((button) => {
        const isActive = button.dataset.languageButton === selectedLanguage;
        button.classList.toggle("active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });
    }

    document.querySelectorAll("[data-language-button]").forEach((button) => {
      button.addEventListener("click", () => {
        setReportLanguage(button.dataset.languageButton);
      });
    });
