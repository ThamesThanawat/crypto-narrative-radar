<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Crypto Narrative Radar - {{ snapshot_date }}</title>
  <style>
    :root {
      --bg: #f2f4f6;
      --panel: #ffffff;
      --panel-alt: #f8fafb;
      --ink: #111827;
      --muted: #5a6673;
      --line: #d4dbe3;
      --line-strong: #a9b5c3;
      --accent: #0f5f6f;
      --accent-2: #2f6f4e;
      --accent-soft: #e6f1f3;
      --terminal: #17202a;
      --warn-soft: #fff4df;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: "Aptos", "Segoe UI", "Trebuchet MS", Verdana, sans-serif;
      line-height: 1.55;
    }

    .page {
      max-width: 1180px;
      margin: 0 auto;
      padding: 32px 20px 56px;
    }

    header {
      background: var(--terminal);
      border: 1px solid #23313f;
      border-radius: 6px;
      color: #f8fafc;
      margin-bottom: 24px;
      padding: 22px 24px;
    }

    h1 {
      font-size: 34px;
      margin: 0 0 6px;
      letter-spacing: 0;
    }

    h2 {
      font-size: 22px;
      margin: 34px 0 12px;
      letter-spacing: 0;
    }

    h3 {
      font-size: 16px;
      margin: 0 0 8px;
      letter-spacing: 0;
    }

    p {
      margin: 0 0 12px;
    }

    .subtitle {
      color: #cbd5df;
      font-size: 16px;
      margin-bottom: 14px;
    }

    .meta {
      color: #aebccc;
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      font-size: 13px;
    }

    .notice {
      background: var(--warn-soft);
      border: 1px solid #ead5aa;
      border-radius: 6px;
      color: #514222;
      padding: 14px 16px;
    }

    .sample-notice {
      background: var(--accent-soft);
      border: 1px solid #bfdfe2;
      border-radius: 6px;
      color: #143d43;
      margin-top: 12px;
      padding: 14px 16px;
    }

    .language-toggle {
      align-items: center;
      display: flex;
      gap: 8px;
      justify-content: flex-end;
      margin: -8px 0 16px;
    }

    .language-button {
      background: var(--panel);
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      color: var(--muted);
      cursor: pointer;
      font: inherit;
      font-size: 13px;
      font-weight: 700;
      padding: 5px 12px;
    }

    .language-button.active {
      background: var(--terminal);
      border-color: var(--terminal);
      color: #f8fafc;
    }

    .cards {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(auto-fit, minmax(245px, 1fr));
      margin-top: 14px;
    }

    .card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 14px;
    }

    .card .label {
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
    }

    .card .value {
      color: var(--accent);
      font-size: 24px;
      font-weight: 700;
      margin: 4px 0;
    }

    .card .note {
      color: var(--muted);
      font-size: 13px;
    }

    ul {
      margin: 0 0 12px 22px;
      padding: 0;
    }

    li {
      margin: 6px 0;
    }

    .table-wrap {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 6px;
      overflow-x: auto;
    }

    table {
      border-collapse: collapse;
      min-width: 760px;
      width: 100%;
    }

    th,
    td {
      border-bottom: 1px solid var(--line);
      padding: 9px 10px;
      text-align: left;
      vertical-align: top;
      white-space: nowrap;
    }

    th {
      background: #edf2f5;
      color: #26333f;
      font-size: 12px;
      text-transform: uppercase;
    }

    td {
      font-size: 13px;
    }

    td,
    .card .value,
    .bar-value,
    .skew-values,
    .axis-labels {
      font-variant-numeric: tabular-nums;
    }

    tr:last-child td {
      border-bottom: 0;
    }

    .section-note {
      color: var(--muted);
      max-width: 880px;
    }

    .chart-panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 16px;
    }

    .bar-chart,
    .skew-chart {
      display: grid;
      gap: 10px;
      margin-top: 14px;
    }

    .bar-row,
    .skew-row {
      align-items: center;
      display: grid;
      gap: 12px;
    }

    .bar-row {
      grid-template-columns: minmax(140px, 190px) minmax(180px, 1fr) 64px;
    }

    .bar-label,
    .skew-label {
      color: var(--ink);
      font-size: 13px;
      font-weight: 700;
    }

    .bar-track,
    .skew-track {
      background: var(--panel-alt);
      border: 1px solid var(--line);
      border-radius: 4px;
      min-height: 18px;
      position: relative;
    }

    .bar-fill {
      background: linear-gradient(90deg, var(--accent), #3f8b95);
      border-radius: 3px;
      height: 18px;
    }

    .bar-value {
      color: var(--terminal);
      font-size: 13px;
      font-weight: 700;
      text-align: right;
    }

    .axis-labels {
      color: var(--muted);
      display: flex;
      font-size: 12px;
      justify-content: space-between;
      margin-top: 10px;
    }

    .skew-row {
      grid-template-columns: minmax(170px, 230px) minmax(220px, 1fr) minmax(190px, 240px);
    }

    .skew-label {
      display: grid;
      gap: 4px;
    }

    .review-pill {
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      color: var(--muted);
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      padding: 2px 8px;
      width: fit-content;
    }

    .review-pill.skew-review,
    .review-pill.dispersion-review,
    .review-pill.skew-dispersion-review {
      background: #fff4df;
      border-color: #d7b46c;
      color: #604a13;
    }

    .review-pill.no-review {
      background: #edf7f1;
      border-color: #b8d9c6;
      color: #28543a;
    }

    .zero-line {
      background: #778494;
      bottom: -4px;
      position: absolute;
      top: -4px;
      width: 1px;
    }

    .skew-marker {
      border-radius: 999px;
      height: 14px;
      position: absolute;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 14px;
    }

    .skew-marker.mean {
      background: var(--accent);
      border: 2px solid #dff3f5;
    }

    .skew-marker.median {
      background: var(--accent-2);
      border: 2px solid #e5f3eb;
      height: 10px;
      width: 10px;
    }

    .skew-values {
      color: var(--muted);
      display: grid;
      font-size: 12px;
      gap: 2px;
    }

    .legend {
      color: var(--muted);
      display: flex;
      flex-wrap: wrap;
      font-size: 12px;
      gap: 12px;
      margin-top: 12px;
    }

    .legend-item {
      align-items: center;
      display: inline-flex;
      gap: 6px;
    }

    .legend-dot {
      border-radius: 999px;
      display: inline-block;
      height: 9px;
      width: 9px;
    }

    .legend-dot.mean {
      background: var(--accent);
    }

    .legend-dot.median {
      background: var(--accent-2);
    }

    .method-box {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 16px;
    }

    footer {
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 12px;
      margin-top: 34px;
      padding-top: 16px;
    }

    @media (max-width: 760px) {
      .bar-row,
      .skew-row {
        grid-template-columns: 1fr;
      }

      .bar-value {
        text-align: left;
      }
    }
  </style>
</head>
<body data-language="en">
  <main class="page">
    {% macro render_table(table_data) -%}
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            {% for column in table_data.columns %}
            <th>{{ table_data.labels.get(column, column.replace('_', ' ').title()) }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in table_data.rows %}
          {% set row_index = loop.index0 %}
          {% set row_translations = table_data.translations[row_index] if table_data.translations else {} %}
          <tr>
            {% for column in table_data.columns %}
            {% set cell_value = row[column]|format_value(column, table_data.formats.get(column)) %}
            {% set translated_value = row_translations.get(column) %}
            <td{% if translated_value %} data-en-text="{{ cell_value }}" data-th-text="{{ translated_value }}"{% endif %}>{{ cell_value }}</td>
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {%- endmacro %}

    <header>
      <h1 data-i18n="reportTitle">Crypto Narrative Radar</h1>
      <p class="subtitle" data-i18n="reportSubtitle">Static market intelligence research report using narrative-level crypto market data.</p>
      <div class="meta">
        <span><span data-i18n="snapshotDateLabel">Snapshot date:</span> {{ snapshot_date }}</span>
        <span><span data-i18n="generatedLabel">Generated:</span> {{ generated_at }}</span>
      </div>
    </header>

    <nav class="language-toggle" aria-label="Report language">
      <button type="button" class="language-button active" data-language-button="en" aria-pressed="true">English</button>
      <button type="button" class="language-button" data-language-button="th" aria-pressed="false">ไทย</button>
    </nav>

    <section class="notice" data-i18n="researchDisclaimer">
      <strong>Research disclaimer:</strong>
      This report is market intelligence only. It is not investment advice, contains no buy/sell recommendations,
      does not provide price prediction, does not include backtesting, and does not provide portfolio allocation guidance.
    </section>

    {% if sample_report_note %}
    <section class="sample-notice">
      <span data-i18n="sampleNotice">{{ sample_report_note }}</span>
    </section>
    {% endif %}

    {% if qa_warnings %}
    <section>
      <h2 data-i18n="dataQualityHeading">Data Quality Notes</h2>
      <ul>
        {% for warning in qa_warnings %}
        <li>{{ warning }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <section>
      <h2 data-i18n="executiveSummaryHeading">Executive Summary</h2>
      {% if summary.bullets %}
      <ul>
        {% for bullet in summary.bullets %}
        {% set bullet_th = summary.bullets_th[loop.index0] if summary.bullets_th else none %}
        <li{% if bullet_th %} data-en-text="{{ bullet }}" data-th-text="{{ bullet_th }}"{% endif %}>{{ bullet }}</li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="section-note" data-i18n="executiveUnavailable">Executive summary metrics were not available for this snapshot.</p>
      {% endif %}
    </section>

    <section>
      <h2 data-i18n="marketSnapshotHeading">Market Snapshot</h2>
      <div class="cards">
        {% for card in summary.cards %}
        <article class="card">
          <div class="label" data-en-text="{{ card.title }}" data-th-text="{{ card.title_th }}">{{ card.title }}</div>
          <h3>{{ card.narrative }}</h3>
          <div class="value">{{ card.value }}</div>
          <div class="note" data-en-text="{{ card.note }}" data-th-text="{{ card.note_th }}">{{ card.note }}</div>
        </article>
        {% endfor %}
      </div>
    </section>

    {% if score_chart.available %}
    <section>
      <h2 data-i18n="scoreChartHeading">Narrative Momentum Score Bar Chart</h2>
      <p class="section-note" data-i18n="scoreChartCaption">Narratives are sorted by the current Narrative Momentum Score. The score is a descriptive research ranking tool and does not affect any return skew diagnostics.</p>
      <div class="chart-panel">
        <div class="bar-chart">
          {% for row in score_chart.rows %}
          <div class="bar-row">
            <div class="bar-label">{{ row.primary_narrative }}</div>
            <div class="bar-track" aria-label="{{ row.primary_narrative }} {{ score_chart.score_label }} {{ row.score_label }}">
              <div class="bar-fill" style="width: {{ row.width_pct }}%;"></div>
            </div>
            <div class="bar-value">{{ row.score_label }}</div>
          </div>
          {% endfor %}
        </div>
        <div class="axis-labels">
          <span>0</span>
          <span>100</span>
        </div>
      </div>
    </section>
    {% endif %}

    {% if return_skew_chart.available %}
    <section>
      <h2 data-i18n="skewChartHeading">Mean vs Median 7D Return Skew Chart</h2>
      <p class="section-note" data-i18n="skewChartCaption">This diagnostic-only view plots mean and median 7D returns by narrative and displays the current review label. It does not affect the Narrative Momentum Score.</p>
      <div class="chart-panel">
        <div class="skew-chart">
          {% for row in return_skew_chart.rows %}
          <div class="skew-row">
            <div class="skew-label">
              <span>{{ row.primary_narrative }}</span>
              <span class="review-pill {{ row.review_flag_class }}" data-en-text="{{ row.review_flag }}" data-th-text="{{ row.review_flag_th }}">{{ row.review_flag }}</span>
            </div>
            <div class="skew-track" aria-label="{{ row.primary_narrative }} mean {{ row.mean_label }} median {{ row.median_label }}">
              {% if return_skew_chart.zero_position_pct is not none %}
              <span class="zero-line" style="left: {{ return_skew_chart.zero_position_pct }}%;"></span>
              {% endif %}
              {% if row.mean_position_pct is not none %}
              <span class="skew-marker mean" style="left: {{ row.mean_position_pct }}%;" title="Mean 7D Return {{ row.mean_label }}"></span>
              {% endif %}
              {% if row.median_position_pct is not none %}
              <span class="skew-marker median" style="left: {{ row.median_position_pct }}%;" title="Median 7D Return {{ row.median_label }}"></span>
              {% endif %}
            </div>
            <div class="skew-values">
              <span><span data-i18n="meanLabel">Mean</span> {{ row.mean_label }}</span>
              <span><span data-i18n="medianLabel">Median</span> {{ row.median_label }}</span>
              <span><span data-i18n="gapLabel">Gap</span> {{ row.gap_label }} | IQR {{ row.iqr_label }}</span>
            </div>
          </div>
          {% endfor %}
        </div>
        <div class="legend">
          <span class="legend-item"><span class="legend-dot mean"></span><span data-i18n="meanLegend">Mean 7D Return</span></span>
          <span class="legend-item"><span class="legend-dot median"></span><span data-i18n="medianLegend">Median 7D Return</span></span>
        </div>
      </div>
    </section>
    {% endif %}

    <section>
      <h2 data-i18n="rankingHeading">Narrative Ranking</h2>
      <p class="section-note" data-i18n="rankingCaption">The ranking table compares narrative-level analysis across momentum, relative strength, volume confirmation, breadth of participation, and concentration context.</p>
      {% set table_data = ranking_table %}
      {% if table_data %}
      {{ render_table(table_data) }}
      {% endif %}
    </section>

    {% if score_component_breakdown %}
    <section>
      <h2 data-i18n="componentHeading">Score Component Breakdown</h2>
      <p class="section-note" data-i18n="componentCaption">
        Component scores are percentile-rank normalized within the current narrative universe and combined into the Narrative Momentum Score. They are relative research ranking inputs, not statistical confidence.
      </p>
      {% set table_data = score_component_breakdown %}
      {{ render_table(table_data) }}
    </section>
    {% endif %}

    <section>
      <h2 data-i18n="returnSkewHeading">Return Skew Diagnostics</h2>
      <p class="section-note" data-i18n="returnSkewCaption">
        This diagnostic compares mean, median, and IQR of 7D returns to show whether a narrative basket is broadly representative or influenced by one/few return outliers. It is diagnostic-only and does not affect the Narrative Momentum Score.
      </p>
      {% if return_skew_note %}
      <p class="section-note" data-en-text="{{ return_skew_note }}" data-th-text="{{ return_skew_note_th }}">{{ return_skew_note }}</p>
      {% endif %}
      {% set table_data = return_skew_diagnostics %}
      {% if table_data %}
      {{ render_table(table_data) }}
      {% endif %}
    </section>

    <section>
      <h2 data-i18n="contributorsHeading">Token-Level Contributors</h2>
      <p class="section-note" data-i18n="contributorsCaption">Token-level contributors show which assets are contributing most to narrative-level market activity.</p>
      {% if token_contributor_note %}
      <p class="section-note" data-en-text="{{ token_contributor_note }}" data-th-text="{{ token_contributor_note_th }}">{{ token_contributor_note }}</p>
      {% endif %}
      {% set table_data = token_contributors %}
      {% if table_data %}
      {{ render_table(table_data) }}
      {% endif %}
    </section>

    <section>
      <h2 data-i18n="concentrationHeading">Concentration Review</h2>
      <p class="section-note" data-i18n="concentrationCaption">Concentration review shows whether narrative-level market cap is more distributed or driven by a small number of large tokens. Labels and comments are judgment-based V1 heuristics, not statistically derived cutoffs.</p>
      {% if concentration_note %}
      <p class="section-note" data-en-text="{{ concentration_note }}" data-th-text="{{ concentration_note_th }}">{{ concentration_note }}</p>
      {% endif %}
      {% set table_data = concentration_review %}
      {% if table_data %}
      {{ render_table(table_data) }}
      {% endif %}
    </section>

    <section>
      <h2 data-i18n="historicalHeading">90-Day Historical Context</h2>
      {% if historical.available %}
      <p class="section-note" data-en-text="{{ historical.summary_note }}" data-th-text="{{ historical.summary_note_th }}">{{ historical.summary_note }}</p>
      {% set table_data = historical.latest_table %}
      {% if table_data %}
      {{ render_table(table_data) }}
      {% endif %}
      {% else %}
      <p class="section-note" data-en-text="{{ historical.note }}" data-th-text="{{ historical.note_th }}">{{ historical.note }}</p>
      {% endif %}
    </section>

    <section>
      <h2 data-i18n="methodologyHeading">Methodology</h2>
      <div class="method-box">
        <p data-i18n="methodologyIntro">Crypto Narrative Radar uses a manually reviewed narrative taxonomy, CoinGecko market data, token-level market snapshots, and narrative-level aggregation to create a descriptive research view.</p>
        <p data-en-text="{{ methodology.score_note }} {{ methodology.small_gap_caution }}" data-th-text="{{ methodology.score_note_th }} {{ methodology.small_gap_caution_th }}">{{ methodology.score_note }} {{ methodology.small_gap_caution }}</p>
        <p data-i18n="scoreFramework">The Narrative Momentum Score uses the current V1 framework: 40% price momentum, 25% relative strength, 20% volume confirmation, and 15% breadth of participation.</p>
        <ul>
          {% for row in methodology.score_weights %}
          <li data-en-text="{{ row.weight }} {{ row.component }}: {{ row.description }}" data-th-text="{{ row.weight }} {{ row.component_th }}: {{ row.description_th }}">{{ row.weight }} {{ row.component }}: {{ row.description }}</li>
          {% endfor %}
        </ul>
        <p data-en-text="{{ methodology.normalization_note }}" data-th-text="{{ methodology.normalization_note_th }}">{{ methodology.normalization_note }}</p>
        <p data-en-text="{{ methodology.relative_strength_note }}" data-th-text="{{ methodology.relative_strength_note_th }}">{{ methodology.relative_strength_note }}</p>
        <p data-en-text="{{ methodology.concentration_note }}" data-th-text="{{ methodology.concentration_note_th }}">{{ methodology.concentration_note }}</p>
        <p data-en-text="{{ methodology.return_skew_note }}" data-th-text="{{ methodology.return_skew_note_th }}">{{ methodology.return_skew_note }}</p>
        <p data-en-text="{{ methodology.token_universe_note }}" data-th-text="{{ methodology.token_universe_note_th }}">{{ methodology.token_universe_note }}</p>
        <p data-en-text="{{ methodology.taxonomy_note }}" data-th-text="{{ methodology.taxonomy_note_th }}">{{ methodology.taxonomy_note }}</p>
        <p data-i18n="sqlAnalyticsNote">DuckDB SQL analytics outputs support narrative summaries, token-level contributors, and concentration context. Historical narrative data, when available, is used only as descriptive trend context.</p>
        <p data-i18n="scoreResearchNote">The score is a research ranking tool for market intelligence. It does not imply future returns.</p>
      </div>
    </section>

    <section>
      <h2 data-i18n="limitationsHeading">Limitations</h2>
      <ul>
        <li data-i18n="limitationAdvice">This report is not investment advice.</li>
        <li data-i18n="limitationRecommendations">It includes no buy/sell recommendations.</li>
        <li data-i18n="limitationPrediction">It includes no price prediction.</li>
        <li data-i18n="limitationBacktesting">It includes no backtesting.</li>
        <li data-i18n="limitationPortfolio">It includes no portfolio allocation guidance.</li>
        <li data-i18n="limitationDescriptive">Snapshot and 90-day historical views are descriptive.</li>
        <li data-i18n="limitationCoingecko">CoinGecko data availability and API limits may affect data quality.</li>
        <li data-i18n="limitationTaxonomy">Taxonomy design involves judgment and should be reviewed over time.</li>
        <li data-i18n="limitationDefillama">No DeFiLlama fundamentals overlay is included yet.</li>
      </ul>
    </section>

    <footer data-i18n="footerText">
      Crypto Narrative Radar static market intelligence report. Generated from existing processed outputs.
    </footer>
  </main>
  <script>
    const thaiTranslations = {
      reportTitle: "Crypto Narrative Radar",
      reportSubtitle: "รายงาน market intelligence แบบ static จากข้อมูลตลาดคริปโตระดับ narrative",
      snapshotDateLabel: "วันที่ snapshot:",
      generatedLabel: "สร้างเมื่อ:",
      researchDisclaimer: "<strong>หมายเหตุการใช้งาน:</strong> รายงานนี้เป็น market intelligence และระบบสนับสนุนงานวิจัยเท่านั้น ไม่ใช่คำแนะนำการลงทุน ไม่ใช่ trading bot ไม่มีคำแนะนำ buy/sell ไม่ใช่การทำนายราคา ไม่มี backtesting และไม่มีคำแนะนำ portfolio allocation",
      sampleNotice: "รายงานตัวอย่างแบบ pinned: รายงานนี้ใช้ snapshot วันที่ 2026-05-20 เพื่อสาธิตวิธีคิดเรื่อง narrative scoring, data quality notes, component breakdown และ return skew diagnostics โดยเป็นตัวอย่าง methodology ที่ทำซ้ำได้ ไม่ใช่อัปเดตตลาดปัจจุบัน",
      dataQualityHeading: "หมายเหตุคุณภาพข้อมูล",
      executiveSummaryHeading: "สรุปผู้บริหาร",
      executiveUnavailable: "ไม่มีข้อมูลสรุปสำหรับ snapshot นี้",
